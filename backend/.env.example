OPENAI_API_KEY=
# cheap model for extraction
OPENAI_MODEL_SMALL=
# used sparingly
OPENAI_MODEL_LARGE=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Sent to reasoning models only (none|minimal|low|medium|high)
OPENAI_REASONING_EFFORT=low
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role key; server only
SUPABASE_SERVICE_ROLE_KEY=
# only for legacy HS256 projects
SUPABASE_JWT_SECRET=
# Supabase Postgres (pooler) connection string
DATABASE_URL=
MCP_SERVICE_TOKEN=
# comma-separated or JSON list
ALLOWED_ORIGINS=http://localhost:3000
DAILY_ANALYSIS_LIMIT=10
DAILY_UPLOAD_LIMIT=100
# Offline question ingestion only (fine-grained token, public repos read-only)
GITHUB_PERSONAL_ACCESS_TOKEN=
# Fernet key that encrypts users' OpenAI keys at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
